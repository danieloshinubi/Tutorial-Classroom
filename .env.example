# Copy this file to .env and fill in the values from your Supabase project
# (Dashboard > Project Settings > API Keys, and > Data API for the URL).
# Restart `npm start` after changing it.
#
# Create React App only exposes variables prefixed with REACT_APP_, and it
# inlines them into the client bundle — so only ever put the anon/publishable
# key here, never the service_role key.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key


# Which tenant to show when the host has no subdomain (local dev).
REACT_APP_DEFAULT_SCHOOL=jane-nath

# Server-side only — used by scripts/migrate.js, never by the app.
# Supabase → Settings → Database → Connection string → URI.
# This is NOT prefixed REACT_APP_, so Create React App will not put it in the
# browser bundle. Keep it that way.
DATABASE_URL=postgresql://postgres.your-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Paystack. Only the PUBLIC key may ever live in a REACT_APP_* variable —
# Create React App inlines those into the JavaScript bundle, where anybody can
# read them. The SECRET key belongs in the Edge Functions' own environment:
#
#   npx supabase secrets set PAYSTACK_SECRET_KEY=sk_live_xxx --project-ref <ref>
#
# It is used by pay-init (to start a transaction) and paystack-webhook (to
# verify that Paystack, and not somebody else, sent the confirmation).
REACT_APP_PAYSTACK_PUBLIC_KEY=
